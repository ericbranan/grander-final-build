{
  "version": "0.4",
  "title": "Search Results",
  "type": "search-results",
  "content": [
    {
      "id": "search-hero",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 1200,
          "sizes": []
        },
        "flex_direction": "column",
        "flex_align_items": "center",
        "padding": {
          "unit": "px",
          "top": "100",
          "right": "40",
          "bottom": "60",
          "left": "40",
          "isLinked": false
        },
        "padding_mobile": {
          "unit": "px",
          "top": "60",
          "right": "20",
          "bottom": "40",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": "#F5F0E8"
      },
      "elements": [
        {
          "id": "search-eyebrow",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Search Results",
            "header_size": "h6",
            "align": "center",
            "title_color": "#B08D66",
            "typography_typography": "custom",
            "typography_font_family": "Corbel",
            "typography_font_size": {
              "unit": "px",
              "size": 13,
              "sizes": []
            },
            "typography_font_weight": "600",
            "typography_text_transform": "uppercase",
            "typography_letter_spacing": {
              "unit": "px",
              "size": 2,
              "sizes": []
            }
          }
        },
        {
          "id": "search-query-display",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Results for: \"{{search_query}}\"",
            "header_size": "h1",
            "align": "center",
            "title_color": "#4C2A19",
            "typography_typography": "custom",
            "typography_font_family": "Libre Baskerville",
            "typography_font_size": {
              "unit": "px",
              "size": 40,
              "sizes": []
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 28,
              "sizes": []
            }
          }
        },
        {
          "id": "search-form-refine",
          "elType": "widget",
          "widgetType": "search-form",
          "settings": {
            "placeholder": "Refine your search...",
            "skin": "classic",
            "button_type": "icon",
            "size": "md",
            "input_typography_typography": "custom",
            "input_typography_font_family": "Corbel",
            "input_typography_font_size": {
              "unit": "px",
              "size": 16,
              "sizes": []
            },
            "input_text_color": "#1A1A1A",
            "input_background_color": "#FFFFFF",
            "input_border_color": "#E8E4DE",
            "input_border_width": {
              "unit": "px",
              "top": "1",
              "right": "1",
              "bottom": "1",
              "left": "1",
              "isLinked": true
            },
            "button_text_color": "#FDFBF8",
            "button_background_color": "#B08D66",
            "_element_width": "auto",
            "width": {
              "unit": "px",
              "size": 500,
              "sizes": []
            },
            "width_mobile": {
              "unit": "%",
              "size": 100,
              "sizes": []
            }
          }
        }
      ]
    },
    {
      "id": "search-results-section",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 1000,
          "sizes": []
        },
        "flex_direction": "column",
        "padding": {
          "unit": "px",
          "top": "80",
          "right": "40",
          "bottom": "100",
          "left": "40",
          "isLinked": false
        },
        "padding_mobile": {
          "unit": "px",
          "top": "40",
          "right": "20",
          "bottom": "60",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": "#FDFBF8"
      },
      "elements": [
        {
          "id": "results-count",
          "elType": "widget",
          "widgetType": "theme-archive-title",
          "settings": {
            "title": "{{results_count}} results found",
            "header_size": "h3",
            "title_color": "#6B4532",
            "typography_typography": "custom",
            "typography_font_family": "Corbel",
            "typography_font_size": {
              "unit": "px",
              "size": 15,
              "sizes": []
            },
            "margin": {
              "unit": "px",
              "top": "0",
              "right": "0",
              "bottom": "40",
              "left": "0",
              "isLinked": false
            }
          }
        },
        {
          "id": "search-results-loop",
          "elType": "widget",
          "widgetType": "archive-posts",
          "settings": {
            "posts_per_page": 10,
            "_skin": "custom",
            "classic_columns": 1,
            "classic_row_gap": {
              "unit": "px",
              "size": 30,
              "sizes": []
            },
            "classic_thumbnail": "yes",
            "thumbnail_size": "medium",
            "classic_meta_data": ["author", "date"],
            "classic_excerpt_length": 30,
            "classic_read_more_text": "Read More",
            "classic_item_ratio": {
              "unit": "px",
              "size": 0.66,
              "sizes": []
            },
            "classic_image_width": {
              "unit": "%",
              "size": 30,
              "sizes": []
            },
            "title_color": "#4C2A19",
            "title_typography_typography": "custom",
            "title_typography_font_family": "Libre Baskerville",
            "title_typography_font_size": {
              "unit": "px",
              "size": 22,
              "sizes": []
            },
            "title_color_hover": "#B08D66",
            "meta_color": "#8B6B5A",
            "meta_typography_typography": "custom",
            "meta_typography_font_family": "Corbel",
            "meta_typography_font_size": {
              "unit": "px",
              "size": 13,
              "sizes": []
            },
            "excerpt_color": "#6B4532",
            "excerpt_typography_typography": "custom",
            "excerpt_typography_font_family": "Corbel",
            "excerpt_typography_font_size": {
              "unit": "px",
              "size": 16,
              "sizes": []
            },
            "read_more_color": "#B08D66",
            "read_more_typography_typography": "custom",
            "read_more_typography_font_family": "Corbel",
            "read_more_typography_font_size": {
              "unit": "px",
              "size": 14,
              "sizes": []
            },
            "read_more_typography_font_weight": "600",
            "item_border_border": "solid",
            "item_border_width": {
              "unit": "px",
              "top": "0",
              "right": "0",
              "bottom": "1",
              "left": "0",
              "isLinked": false
            },
            "item_border_color": "#E8E4DE",
            "item_padding": {
              "unit": "px",
              "top": "0",
              "right": "0",
              "bottom": "30",
              "left": "0",
              "isLinked": false
            },
            "css_classes": "gc-search-results"
          }
        },
        {
          "id": "search-pagination",
          "elType": "widget",
          "widgetType": "archive-posts",
          "settings": {
            "pagination_type": "numbers_and_prev_next",
            "pagination_previous_label": "← Previous",
            "pagination_next_label": "Next →",
            "pagination_align": "center",
            "pagination_page_limit": 5,
            "pagination_color": "#4C2A19",
            "pagination_typography_typography": "custom",
            "pagination_typography_font_family": "Corbel",
            "pagination_typography_font_size": {
              "unit": "px",
              "size": 15,
              "sizes": []
            },
            "pagination_color_hover": "#B08D66",
            "pagination_active_color": "#B08D66"
          }
        }
      ]
    },
    {
      "id": "no-results-section",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 700,
          "sizes": []
        },
        "flex_direction": "column",
        "flex_align_items": "center",
        "padding": {
          "unit": "px",
          "top": "80",
          "right": "40",
          "bottom": "100",
          "left": "40",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": "#FDFBF8",
        "conditions": {
          "terms": [
            {
              "name": "no_posts",
              "operator": "===",
              "value": "true"
            }
          ]
        },
        "css_classes": "gc-no-results"
      },
      "elements": [
        {
          "id": "no-results-icon",
          "elType": "widget",
          "widgetType": "icon",
          "settings": {
            "selected_icon": {
              "value": "fas fa-search",
              "library": "fa-solid"
            },
            "align": "center",
            "primary_color": "#E8E4DE",
            "size": {
              "unit": "px",
              "size": 80,
              "sizes": []
            }
          }
        },
        {
          "id": "no-results-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "No Results Found",
            "header_size": "h2",
            "align": "center",
            "title_color": "#4C2A19",
            "typography_typography": "custom",
            "typography_font_family": "Libre Baskerville",
            "typography_font_size": {
              "unit": "px",
              "size": 32,
              "sizes": []
            }
          }
        },
        {
          "id": "no-results-message",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align: center;\">We couldn't find any results matching your search. Try different keywords or browse our pages below.</p>",
            "text_color": "#6B4532",
            "typography_typography": "custom",
            "typography_font_family": "Corbel",
            "typography_font_size": {
              "unit": "px",
              "size": 17,
              "sizes": []
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.7,
              "sizes": []
            }
          }
        },
        {
          "id": "no-results-links",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "column",
            "flex_align_items": "center",
            "margin": {
              "unit": "px",
              "top": "40",
              "right": "0",
              "bottom": "0",
              "left": "0",
              "isLinked": false
            }
          },
          "elements": [
            {
              "id": "quick-links-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Popular Pages",
                "header_size": "h4",
                "align": "center",
                "title_color": "#B08D66",
                "typography_typography": "custom",
                "typography_font_family": "Corbel",
                "typography_font_size": {
                  "unit": "px",
                  "size": 13,
                  "sizes": []
                },
                "typography_font_weight": "600",
                "typography_text_transform": "uppercase",
                "typography_letter_spacing": {
                  "unit": "px",
                  "size": 2,
                  "sizes": []
                }
              }
            },
            {
              "id": "quick-links-list",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {
                    "_id": "link-1",
                    "text": "Custom Homes",
                    "link": {
                      "url": "/custom-homes/"
                    },
                    "selected_icon": {
                      "value": "fas fa-chevron-right",
                      "library": "fa-solid"
                    }
                  },
                  {
                    "_id": "link-2",
                    "text": "Our Build Process",
                    "link": {
                      "url": "/build-process/"
                    },
                    "selected_icon": {
                      "value": "fas fa-chevron-right",
                      "library": "fa-solid"
                    }
                  },
                  {
                    "_id": "link-3",
                    "text": "Project Gallery",
                    "link": {
                      "url": "/gallery/"
                    },
                    "selected_icon": {
                      "value": "fas fa-chevron-right",
                      "library": "fa-solid"
                    }
                  },
                  {
                    "_id": "link-4",
                    "text": "Contact Us",
                    "link": {
                      "url": "/contact/"
                    },
                    "selected_icon": {
                      "value": "fas fa-chevron-right",
                      "library": "fa-solid"
                    }
                  }
                ],
                "icon_align": "left",
                "space_between": {
                  "unit": "px",
                  "size": 15,
                  "sizes": []
                },
                "icon_color": "#B08D66",
                "icon_size": {
                  "unit": "px",
                  "size": 12,
                  "sizes": []
                },
                "text_color": "#4C2A19",
                "text_color_hover": "#B08D66",
                "text_typography_typography": "custom",
                "text_typography_font_family": "Corbel",
                "text_typography_font_size": {
                  "unit": "px",
                  "size": 16,
                  "sizes": []
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "page_settings": {
    "hide_title": "yes"
  },
  "metadata": {
    "condition_type": "include",
    "conditions": ["include/archive/search"]
  }
}
