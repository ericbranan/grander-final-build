  "page_settings": {
    "hide_title": "yes"
  },
  "metadata": {
    "condition_type": "include",
    "conditions": ["include/singular/not_found404"]
  },
  "custom_css": "",
  "custom_js": "document.addEventListener('DOMContentLoaded', function() {\n  var backButton = document.getElementById('gc-back-button');\n  if (backButton) {\n    backButton.addEventListener('click', function(e) {\n      e.preventDefault();\n      if (window.history.length > 1 && document.referrer !== '') {\n        window.history.back();\n      } else {\n        window.location.href = '/';\n      }\n    });\n  }\n});"
}
