  "custom_css": ".gc-post-content h2 { font-family: 'Libre Baskerville', serif; font-size: 32px; color: #4C2A19; margin: 40px 0 20px; }\n.gc-post-content h3 { font-family: 'Libre Baskerville', serif; font-size: 26px; color: #4C2A19; margin: 35px 0 15px; }\n.gc-post-content h4 { font-family: 'Libre Baskerville', serif; font-size: 22px; color: #4C2A19; margin: 30px 0 15px; }\n.gc-post-content p { margin-bottom: 1.5em; }\n.gc-post-content ul, .gc-post-content ol { margin: 1.5em 0; padding-left: 1.5em; }\n.gc-post-content li { margin-bottom: 0.5em; }\n.gc-post-content blockquote { border-left: 4px solid #B08D66; padding: 20px 30px; margin: 30px 0; background: #F5F0E8; font-style: italic; font-size: 20px; color: #4C2A19; }\n.gc-post-content img { max-width: 100%; height: auto; margin: 30px 0; }"
}
