          "settings": {
            "tabs": [
              {
                "_id": "faq-1",
                "tab_title": "What areas do you serve?",
                "tab_content": "We primarily serve Middle Tennessee, including Nashville, Franklin, Brentwood, Murfreesboro, and surrounding areas. We're happy to discuss projects throughout the region."
              },
              {
                "_id": "faq-2",
                "tab_title": "How long does a typical project take?",
                "tab_content": "Project timelines vary based on scope and complexity. A custom home typically takes 10-14 months from groundbreaking. Additions and outdoor structures generally range from 3-6 months. We provide detailed timelines during the planning phase."
              },
              {
                "_id": "faq-3",
                "tab_title": "Do you provide design services?",
                "tab_content": "Yes! We work with talented architects and designers, or we can collaborate with your existing design team. Our design-build approach ensures seamless coordination from concept through completion."
              },
              {
                "_id": "faq-4",
                "tab_title": "What is your warranty policy?",
                "tab_content": "We stand behind our work with comprehensive warranties. All Grander homes include a 1-year builder warranty covering workmanship and materials, plus extended warranties on major systems and structural components."
              },
              {
                "_id": "faq-5",
                "tab_title": "How do I get started?",
                "tab_content": "Simply fill out our estimate request form or give us a call. We'll schedule a consultation to discuss your vision, review your site (if applicable), and provide guidance on next steps and budget expectations."
              }
