                  {
                    "_id": "budget",
                    "field_type": "select",
                    "field_label": "Estimated Budget",
                    "required": "false",
                    "width": "100",
                    "field_options": "Under $250,000\n$250,000 - $500,000\n$500,000 - $1,000,000\n$1,000,000+\nNot Sure Yet"
                  },
                  {
                    "_id": "message",
                    "field_type": "textarea",
                    "field_label": "Tell Us About Your Project",
                    "placeholder": "Describe your project vision, specific needs, or any questions you have...",
                    "required": "false",
                    "width": "100",
                    "rows": 4
                  },
                  {
                    "_id": "how_heard",
                    "field_type": "select",
                    "field_label": "How Did You Hear About Us?",
                    "required": "false",
                    "width": "100",
                    "field_options": "Google Search\nReferral\nSocial Media\nHouzz\nDriving By\nOther"
