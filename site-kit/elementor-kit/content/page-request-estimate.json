                    "_id": "project_type",
                    "field_type": "select",
                    "field_label": "Project Type",
                    "required": "true",
                    "width": "50",
                    "field_options": "Custom Home\nAddition / Expansion\nOutdoor Structure\nPool House / ADU\nRenovation\nOther"
                  },
                  {
                    "_id": "timeline",
                    "field_type": "select",
                    "field_label": "Desired Timeline",
                    "required": "false",
                    "width": "50",
                    "field_options": "Within 3 months\n3-6 months\n6-12 months\nFlexible"
