        "padding": {"unit": "px", "top": "140", "right": "40", "bottom": "80", "left": "40", "isLinked": false},
        "background_background": "classic",
        "background_color": "#F5F0E8"
      },
      "elements": [
        {"id": "hero-eyebrow", "elType": "widget", "widgetType": "heading", "settings": {"title": "About Grander", "header_size": "h6", "align": "center", "title_color": "#B08D66", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 13}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 2}}},
        {"id": "hero-title", "elType": "widget", "widgetType": "heading", "settings": {"title": "Building Excellence Since 2003", "header_size": "h1", "align": "center", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 52}, "typography_font_size_mobile": {"unit": "px", "size": 36}}},
        {"id": "hero-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align: center;\">For over two decades, Grander Construction has been Middle Tennessee's trusted partner for exceptional custom homes and outdoor living spaces.</p>", "text_color": "#6B4532", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 18}, "typography_line_height": {"unit": "em", "size": 1.7}}}
      ]
    },
    {
      "id": "story-section",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1200},
        "flex_direction": "row",
        "flex_gap": {"unit": "px", "size": 80},
        "flex_wrap": "wrap",
        "padding": {"unit": "px", "top": "100", "right": "40", "bottom": "100", "left": "40", "isLinked": false},
        "background_background": "classic",
        "background_color": "#FDFBF8"
      },
      "elements": [
        {
          "id": "story-image",
          "elType": "container",
          "isInner": true,
          "settings": {"content_width": "auto", "width": {"unit": "%", "size": 45}, "width_tablet": {"unit": "%", "size": 100}},
          "elements": [
            {"id": "img", "elType": "widget", "widgetType": "image", "settings": {"image": {"url": "", "id": ""}, "image_size": "large", "border_border": "solid", "border_width": {"unit": "px", "top": "2", "right": "2", "bottom": "2", "left": "2", "isLinked": true}, "border_color": "#B08D66"}}
          ]
        },
        {
          "id": "story-content",
          "elType": "container",
          "isInner": true,
          "settings": {"content_width": "auto", "width": {"unit": "%", "size": 50}, "width_tablet": {"unit": "%", "size": 100}, "flex_direction": "column", "flex_justify_content": "center"},
          "elements": [
            {"id": "story-eyebrow", "elType": "widget", "widgetType": "heading", "settings": {"title": "Our Story", "header_size": "h6", "title_color": "#B08D66", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 13}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 2}}},
            {"id": "story-heading", "elType": "widget", "widgetType": "heading", "settings": {"title": "A Foundation Built on Passion", "header_size": "h2", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 36}}},
            {"id": "story-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>What began as a small custom building company in 2003 has grown into one of Middle Tennessee's most respected builders. Our founder's vision was simple: build homes the way they should be built, with uncompromising quality and genuine care for every client.</p><p>Two decades later, that vision remains at the heart of everything we do. We've built over 500 custom homes and outdoor structures, each one a testament to our commitment to excellence.</p>", "text_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 17}, "typography_line_height": {"unit": "em", "size": 1.7}}}
          ]
        }
      ]
    },
    {
      "id": "mission-quote",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 900},
        "flex_direction": "column",
        "flex_align_items": "center",
        "padding": {"unit": "px", "top": "80", "right": "60", "bottom": "80", "left": "60", "isLinked": false},
        "background_background": "classic",
        "background_color": "#4C2A19"
      },
      "elements": [
        {"id": "quote-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<blockquote style=\"text-align: center; font-style: italic; margin: 0;\">\"Our mission is simple: to build homes that exceed expectations while making the journey enjoyable for our clients. Every nail driven, every detail considered, reflects our commitment to your vision.\"</blockquote>", "text_color": "#FDFBF8", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 24}, "typography_line_height": {"unit": "em", "size": 1.5}}},
        {"id": "quote-author", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align: center;\">— Grander Construction Founding Philosophy</p>", "text_color": "#B08D66", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 14}, "typography_font_weight": "600"}}
      ]
    },
    {
      "id": "values-section",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1200},
        "flex_direction": "column",
        "padding": {"unit": "px", "top": "100", "right": "40", "bottom": "100", "left": "40", "isLinked": false},
        "background_background": "classic",
        "background_color": "#F5F0E8"
      },
      "elements": [
        {
          "id": "values-header",
          "elType": "container",
          "isInner": true,
          "settings": {"content_width": "full", "flex_direction": "column", "flex_align_items": "center", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "60", "left": "0", "isLinked": false}},
          "elements": [
            {"id": "values-eyebrow", "elType": "widget", "widgetType": "heading", "settings": {"title": "Our Values", "header_size": "h6", "align": "center", "title_color": "#B08D66", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 13}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 2}}},
            {"id": "values-heading", "elType": "widget", "widgetType": "heading", "settings": {"title": "What Guides Us", "header_size": "h2", "align": "center", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 40}}}
          ]
        },
        {
          "id": "values-grid",
          "elType": "container",
          "isInner": true,
          "settings": {"content_width": "full", "flex_direction": "row", "flex_wrap": "wrap", "flex_gap": {"unit": "px", "size": 30}},
          "elements": [
            {"id": "value-1", "elType": "container", "isInner": true, "settings": {"content_width": "auto", "width": {"unit": "%", "size": 31}, "width_tablet": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}, "flex_direction": "column", "padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "background_background": "classic", "background_color": "#FFFFFF"}, "elements": [{"id": "v1-title", "elType": "widget", "widgetType": "heading", "settings": {"title": "Integrity", "header_size": "h4", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 22}}}, {"id": "v1-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We do what we say and say what we do. Honest communication and ethical practices are non-negotiable.</p>", "text_color": "#6B4532", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 15}, "typography_line_height": {"unit": "em", "size": 1.6}}}]},
            {"id": "value-2", "elType": "container", "isInner": true, "settings": {"content_width": "auto", "width": {"unit": "%", "size": 31}, "width_tablet": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}, "flex_direction": "column", "padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "background_background": "classic", "background_color": "#FFFFFF"}, "elements": [{"id": "v2-title", "elType": "widget", "widgetType": "heading", "settings": {"title": "Craftsmanship", "header_size": "h4", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 22}}}, {"id": "v2-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Every detail matters. We combine time-honored techniques with modern innovation to build homes that last.</p>", "text_color": "#6B4532", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 15}, "typography_line_height": {"unit": "em", "size": 1.6}}}]},
            {"id": "value-3", "elType": "container", "isInner": true, "settings": {"content_width": "auto", "width": {"unit": "%", "size": 31}, "width_tablet": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}, "flex_direction": "column", "padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "background_background": "classic", "background_color": "#FFFFFF"}, "elements": [{"id": "v3-title", "elType": "widget", "widgetType": "heading", "settings": {"title": "Partnership", "header_size": "h4", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 22}}}, {"id": "v3-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Your home is a collaboration. We listen, advise, and work alongside you to bring your vision to life.</p>", "text_color": "#6B4532", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 15}, "typography_line_height": {"unit": "em", "size": 1.6}}}]}
          ]
        }
      ]
    },
