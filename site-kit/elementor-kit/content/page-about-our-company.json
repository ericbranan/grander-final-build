      },
      "elements": [
        {"id": "cta-heading", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ready to Start Your Journey?", "header_size": "h2", "align": "center", "title_color": "#4C2A19", "typography_typography": "custom", "typography_font_family": "Libre Baskerville", "typography_font_size": {"unit": "px", "size": 40}}},
        {"id": "cta-text", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align: center;\">Let's discuss your vision and explore how Grander Construction can help build your dream.</p>", "text_color": "#6B4532", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 18}}},
        {"id": "cta-btn", "elType": "widget", "widgetType": "button", "settings": {"text": "Request an Estimate", "link": {"url": "/request-an-estimate/", "custom_attributes": "data-gc-estimate-trigger:true"}, "size": "lg", "button_text_color": "#FDFBF8", "background_color": "#B08D66", "button_text_color_hover": "#FDFBF8", "button_background_hover_color": "#8B6F4E", "typography_typography": "custom", "typography_font_family": "Corbel", "typography_font_size": {"unit": "px", "size": 15}, "typography_font_weight": "600", "typography_text_transform": "uppercase", "button_padding": {"unit": "px", "top": "18", "right": "40", "bottom": "18", "left": "40", "isLinked": false}, "css_classes": "gc-btn gc-btn--primary gc-estimate-trigger"}}
      ]
